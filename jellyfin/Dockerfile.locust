# Build from the repo root: docker build -f jellyfin/Dockerfile.locust -t jfstress-locust .
FROM locustio/locust:2.47.0
RUN pip install --no-cache-dir prometheus-client==0.26.0
COPY stresskit/ /home/locust/stresskit/
COPY jellyfin/jfcore.py jellyfin/locustfile.py /home/locust/
WORKDIR /home/locust
EXPOSE 8089 9646
CMD ["-f", "/home/locust/locustfile.py", "--class-picker"]
